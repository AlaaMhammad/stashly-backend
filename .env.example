APP_NAME=Stashly
APP_ENV=local
APP_KEY=
# Production MUST set APP_ENV=production and APP_DEBUG=false (php artisan stashly:preflight checks this).
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Served by GET /api/v1/config. Set per release; no production values are assumed (DEC-010).
STASHLY_MIN_SUPPORTED_APP_VERSION=
STASHLY_LATEST_APP_VERSION=
STASHLY_TERMS_VERSION=
STASHLY_TERMS_URL=
STASHLY_PRIVACY_URL=

# Google Sign-In (POST /api/v1/auth/google, DEC-035): OAuth 2.0 client ID that ID tokens must be issued for. Empty = disabled.
GOOGLE_CLIENT_ID=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Target engine is MySQL (see plan.md). Fill credentials in your local .env only; never commit them.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stashly
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Not "log": the log mailer writes password-reset links (secrets) into the application log.
MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (load balancer). Empty = trust none.
TRUSTED_PROXIES=

# Browser origins allowed by CORS (comma-separated, exact). Empty = none; the Android app needs none.
CORS_ALLOWED_ORIGINS=
